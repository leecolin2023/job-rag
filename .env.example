# Default: local SQLite, no model key required. Relative to your working directory.
DATABASE_URL=sqlite:///runtime/jobs.db
# PostgreSQL alternative (start database with docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://jobrag:jobrag@localhost:5432/jobrag

# Optional OpenAI-compatible embedding service. Both model and key enable it.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Change this when changing models/providers/preprocessing; then run reindex.
EMBEDDING_VERSION=v1
EMBEDDING_API_FORMAT=openai
EMBEDDING_BATCH_SIZE=20
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_TRUST_ENV=false

# Existing v0.1 databases: back up, run job-rag migrate, then job-rag reindex.
CHUNKING_STRATEGY=section_typed
CHUNK_SIZE=1100
CHUNK_BUDGET_UNIT=chars
# Use tokens only with a verified model-specific local tokenizer JSON.
TOKENIZER_PATH=

# Optional OpenAI-compatible chat service. Never exposed to browser.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=
# Optional native DashScope rerank; candidate requests must also set rerank=true.
# Base URL includes /api/v1. No key reuse or model call by default.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TOKENIZER_PATH=
# Disabled by default. Set a strong token before using status/import APIs.
ADMIN_TOKEN=
