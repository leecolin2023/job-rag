# Copy to .env.experiments; chmod 600. Never put real keys in chat or Git.
# API Host comes from the Bailian workspace console, NOT from the API key.
BAILIAN_API_HOST=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
BAILIAN_EMBEDDING_DIMENSIONS=1024
BAILIAN_RERANK_MODEL=qwen3.7-text-rerank
BAILIAN_BATCH_SIZE=20
BAILIAN_TRUST_ENV=false
# Enable only when the terminal's configured HTTP(S)_PROXY is required.
# All paid requests are cached in runtime/experiments and logged without keys.
