# Copy to .env.docker and replace the password with a random hexadecimal value.
# Run: sudo docker compose --env-file .env.docker up -d --build
POSTGRES_PASSWORD=replace_with_random_hex_password
JOB_RAG_API_PORT=8008
JOB_RAG_MCP_PORT=8009
# Admin APIs remain disabled unless this is set. MCP is always read-only.
ADMIN_TOKEN=

# Optional dedicated Embedding service; DeepSeek Flash is NOT an embedding model.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=v1
EMBEDDING_API_FORMAT=openai
EMBEDDING_BATCH_SIZE=20
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_TRUST_ENV=false
CHUNKING_STRATEGY=section_typed
CHUNK_SIZE=1100
CHUNK_BUDGET_UNIT=chars
TOKENIZER_PATH=
